# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Gemini API key from Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="LeadFlow <no-reply@your-verified-domain.com>"

# Usa la cadena PostgreSQL de Supabase (Settings > Database > Connection string).
# GOOGLE Calendar API: OAuth client con acceso de escritura al calendario.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# https://vercel.com/docs/redis
REDIS_URL=****
